<Window x:Class="WindowBackgroundMemoWidget.Views.MarkdownMigrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="기존 메모를 Markdown으로 가져오기" Width="720" Height="570"
        MinWidth="620" MinHeight="500" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}" AutomationProperties.Name="기존 메모 Markdown 전환">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="기존 메모 가져오기" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       Text="원본 DB 또는 JSON 백업을 읽기 전용으로 확인합니다. 변환은 아래에서 직접 확인한 뒤에만 시작합니다."/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SourcePathBox" Grid.Column="0" MinHeight="36" Padding="10,6" IsReadOnly="True"
                     AutomationProperties.Name="가져올 DB 또는 JSON 파일 경로"/>
            <Button Grid.Column="1" Content="파일 선택…" Margin="8,0,0,0" Padding="12,6" Click="OnBrowseClick"
                    AutomationProperties.Name="가져올 파일 선택"/>
            <Button x:Name="PreviewButton" Grid.Column="2" Content="미리보기" Margin="8,0,0,0" Padding="12,6" Click="OnPreviewClick"
                    AutomationProperties.Name="가져올 파일 읽기 전용 미리보기"/>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="미리보기" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="PreviewSummary" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               Text="파일을 선택하고 미리보기를 실행하세요. 이 단계에서는 원본과 앱 데이터를 변경하지 않습니다."/>
                    <TextBlock x:Name="HashSummary" Margin="0,10,0,0" TextWrapping="Wrap" FontFamily="Consolas"
                               Foreground="{StaticResource MutedBrush}"/>
                    <Border Margin="0,16,0,0" Padding="12" Background="{StaticResource DeepBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="변환 확인" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                       Text="계속을 누르면 별도의 Markdown 저장 위치에 메모를 복사하고 검증합니다. 원본 파일은 그대로 두며, 실패하면 새 위치의 staging 결과를 되돌립니다."/>
                            <TextBlock x:Name="DestinationSummary" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}"
                               AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="취소" MinWidth="96" Padding="12,7" Click="OnCancelClick"
                    AutomationProperties.Name="Markdown 가져오기 취소 또는 진행 중단"/>
            <Button x:Name="ConfirmButton" Content="확인하고 변환" MinWidth="130" Padding="12,7" Margin="8,0,0,0"
                    IsEnabled="False" Click="OnConfirmClick" AutomationProperties.Name="확인된 원본 파일을 Markdown으로 변환"/>
        </StackPanel>
    </Grid>
</Window>
