<Window x:Class="WindowBackgroundMemoWidget.Views.NotesManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WindowBackgroundMemoWidget.Views"
        Title="메모" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Width="1440" Height="860"
        MinWidth="620" MinHeight="460"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        SizeChanged="OnWindowSizeChanged"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        AutomationProperties.Name="메모 관리 창">
    <Window.Resources>
        <!--
        name         : NotesNativeDensityStyles
        desc         : 기존 Dracula 팔레트를 유지하면서 카드·버튼·본문의 시각 밀도와 포커스 상태를 가볍게 조정한다.
        author       : NotedexOrig3
        create date  : 2026-10-24
        update date  : 2026-10-24 NotedexOrig3 : 실제 참고 화면을 따라 Dracula 색을 유지하고 목록/본문 위계를 재정리.
                       2026-10-24 NotedexOrig3 : 메모 행 밀도·탐색 대비·중복 제목을 낮춰 본문 우선 계층을 정리.
        -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#282A36" />
        <SolidColorBrush x:Key="PanelBrush" Color="#343746" />
        <SolidColorBrush x:Key="BorderBrush" Color="#44475A" />
        <SolidColorBrush x:Key="DeepBrush" Color="#21222C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#BD93F9" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8F8F2" />
        <SolidColorBrush x:Key="MutedBrush" Color="#C1B4DA" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#8E70AD" />
        <SolidColorBrush x:Key="HoverBrush" Color="#51445F" />
        <SolidColorBrush x:Key="PressedBrush" Color="#665276" />
        <SolidColorBrush x:Key="FocusBrush" Color="#D6ACFF" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF5555" />
        <Style x:Key="MemoNativeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource PressedBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource FocusBrush}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MemoNativeButtonStyle}" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MemoNativeButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource MemoNativeButtonStyle}" />
        <Style x:Key="MemoEditorStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource DeepBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="SelectionOpacity" Value="0.55" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontFamily" Value="Malgun Gothic" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" /><Setter Property="BorderThickness" Value="2" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="MinHeight" Value="30" /></Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PaneBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="AllViewButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedView}" Value="all"><Setter Property="Background" Value="{StaticResource HoverBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="PinnedViewButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedView}" Value="pinned"><Setter Property="Background" Value="{StaticResource HoverBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="TrashViewButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedView}" Value="trash"><Setter Property="Background" Value="{StaticResource HoverBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ShowMemoButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMemo.IsVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding IsTrashView}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding GlobalHidden}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HideMemoButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMemo.IsVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding IsTrashView}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TrashOnlyButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding IsTrashView}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ActiveOnlyButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsTrashView}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="PaneTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="SurfaceTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MemoEditorStyle}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentBrush}" /><Setter Property="Foreground" Value="{StaticResource BackgroundBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource DeepBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="DropDownToggle" Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}" Focusable="False" IsTabStop="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left" RecognizesAccessKey="True" />
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="{TemplateBinding Foreground}"
                                                      StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource PressedBrush}" /></Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource FocusBrush}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.55" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource TemplatedParent}}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   Placement="Bottom" StaysOpen="False"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource ControlBorderBrush}"
                                        BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280" CanContentScroll="True" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                                <Setter TargetName="DropDownToggle" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MemoListItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="10,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2,0,0,1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2,0,0,1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="MemoListItemTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PinnedGlyph" Text="&#xE840;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0"
                               AutomationProperties.Name="고정된 메모" Visibility="Collapsed" />
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="15"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="메모 제목" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding Preview}"
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,2"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="본문 미리보기" />
                <Grid Grid.Row="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ModifiedLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               TextWrapping="NoWrap" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding PriorityLabel}" Foreground="{StaticResource TextBrush}" FontSize="11"
                               TextWrapping="NoWrap" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding VisibilityLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding VisibilityLabel}"
                               AutomationProperties.HelpText="{Binding VisibilityLabel}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="PinnedGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource DeepBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,0,8" MinHeight="46">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="메모" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="전체 숨김 중" VerticalAlignment="Center" Margin="8,0,10,0"
                           Foreground="{StaticResource TextBrush}" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding GlobalHidden}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding NewMemoCommand}" Click="OnNewMemoClick"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" MinWidth="98" MinHeight="34"
                        AutomationProperties.Name="새 메모 만들기" ToolTip="Ctrl+N">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource IconStyle}" /><TextBlock Text="새 메모" /></StackPanel>
                </Button>
                </StackPanel>
                <Button Grid.Column="3" x:Name="GlobalActionsButton" Content="⋯" FontSize="20" Padding="9,2" MinWidth="38" MinHeight="34"
                        AutomationProperties.Name="메모 전체 설정과 백업" ToolTip="전체 설정·백업">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="전체 메모 숨기기" IsCheckable="True" IsChecked="{Binding GlobalHidden, Mode=TwoWay}"
                                      ToolTip="개별 표시 설정은 유지됩니다." AutomationProperties.Name="전체 메모 표시 억제 또는 해제" />
                            <Separator />
                            <MenuItem Header="모든 메모 배치 초기화" Command="{Binding ResetAllPlacementsCommand}" />
                            <Separator />
                            <MenuItem Header="메모 백업 내보내기" Command="{Binding ExportCommand}" />
                            <MenuItem Header="메모 백업 복원" Command="{Binding ImportCommand}" />
                            <Separator />
                            <MenuItem Header="도움말 · PDF 설명" Click="OnHelpMenuClick"
                                      AutomationProperties.Name="Notedex 사용 안내와 PDF 설명 열기" />
                            <Separator />
                            <MenuItem Header="Windows 로그인 시 자동 시작" IsCheckable="True"
                                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                      IsEnabled="{Binding CanConfigureStartup}"
                                      AutomationProperties.Name="Windows 로그인 시 Notedex 자동 시작" />
                            <MenuItem Header="시작 설정 다시 확인" Command="{Binding RefreshStartupCommand}" />
                            <Separator />
                            <MenuItem Header="Notedex · 0.3.0" IsEnabled="False" AutomationProperties.Name="Notedex 버전 0.3.0" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <Grid x:Name="ManagerGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="190" />
                <ColumnDefinition x:Name="ListColumn" Width="300" />
                <ColumnDefinition x:Name="EditorColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 전체/고정/휴지통, 폴더와 태그 탐색 -->
            <Border x:Name="SidebarPane" Grid.Column="0" Style="{StaticResource PaneBorderStyle}"
                    CornerRadius="12,0,0,12" Margin="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="탐색" Style="{StaticResource PaneTitleStyle}" />
                        <Button x:Name="NavigationBackButton" Grid.Column="1" Content="‹ 목록" Padding="8,3" MinHeight="34"
                                Visibility="Collapsed" Click="OnCompactListClick"
                                AutomationProperties.Name="메모 목록으로 돌아가기" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Visibility="Collapsed">
                        <Separator Margin="0,0,0,12" Background="{StaticResource BorderBrush}" />
                        <Button Command="{Binding ExportCommand}" MinHeight="40" AutomationProperties.Name="메모 백업 내보내기">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource IconStyle}" /><TextBlock Text="메모 백업 내보내기" /></StackPanel>
                        </Button>
                        <Button Command="{Binding ImportCommand}" MinHeight="40" AutomationProperties.Name="메모 백업 복원">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B5;" Style="{StaticResource IconStyle}" /><TextBlock Text="메모 백업 복원" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Button Style="{StaticResource AllViewButtonStyle}" Command="{Binding SelectViewCommand}"
                                    CommandParameter="all" Click="OnSidebarSelectionClick" AutomationProperties.Name="전체 메모 보기">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource IconStyle}" /><TextBlock Text="전체 메모" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PinnedViewButtonStyle}" Command="{Binding SelectViewCommand}"
                                    CommandParameter="pinned" Click="OnSidebarSelectionClick" AutomationProperties.Name="고정된 메모 보기">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE840;" Style="{StaticResource IconStyle}" /><TextBlock Text="고정됨" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource TrashViewButtonStyle}" Command="{Binding SelectViewCommand}"
                                    CommandParameter="trash" Click="OnSidebarSelectionClick" AutomationProperties.Name="휴지통 보기">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconStyle}" /><TextBlock Text="휴지통" /></StackPanel>
                            </Button>

                            <Separator Margin="0,12" Background="{StaticResource BorderBrush}" />
                            <TextBlock Text="폴더" Style="{StaticResource PaneTitleStyle}" />
                            <ItemsControl ItemsSource="{Binding Folders}" AutomationProperties.Name="메모 폴더 목록">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavButtonStyle}"
                                                Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Click="OnSidebarSelectionClick"
                                                AutomationProperties.Name="폴더 선택">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconStyle}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Expander Header="폴더 관리" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}">
                            <StackPanel Margin="0,6,0,0">
                            <TextBox Text="{Binding FolderNameInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SurfaceTextBoxStyle}" Margin="0,0,0,4"
                                     AutomationProperties.Name="새 폴더 이름" ToolTip="폴더 이름" />
                            <WrapPanel>
                                <Button Command="{Binding AddFolderCommand}" MinHeight="38" Padding="10,6"
                                        AutomationProperties.Name="폴더 추가">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource IconStyle}" /><TextBlock Text="폴더 추가" /></StackPanel>
                                </Button>
                            <Button Command="{Binding RenameFolderCommand}" MinHeight="38" Padding="10,6" AutomationProperties.Name="선택한 폴더 이름 변경">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{StaticResource IconStyle}" /><TextBlock Text="이름 변경" /></StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteFolderCommand}" MinHeight="38" Padding="10,6" AutomationProperties.Name="선택한 폴더 삭제">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconStyle}" /><TextBlock Text="삭제" /></StackPanel>
                            </Button>
                            </WrapPanel>
                            </StackPanel>
                            </Expander>

                            <Separator Margin="0,12" Background="{StaticResource BorderBrush}" />
                            <TextBlock Text="태그" Style="{StaticResource PaneTitleStyle}" />
                            <ItemsControl ItemsSource="{Binding AllTags}" AutomationProperties.Name="저장된 태그">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavButtonStyle}"
                                                Command="{Binding DataContext.SelectTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Click="OnSidebarSelectionClick"
                                                AutomationProperties.Name="태그로 메모 필터">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="#" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Expander Header="태그 관리" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}">
                            <StackPanel Margin="0,6,0,0">
                            <TextBox Text="{Binding TagInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SurfaceTextBoxStyle}" Margin="0,8,0,4"
                                     AutomationProperties.Name="새 태그 이름" ToolTip="태그 이름" />
                            <Button Command="{Binding AddTagCommand}" MinHeight="38" Padding="10,6" AutomationProperties.Name="태그 추가">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource IconStyle}" /><TextBlock Text="태그 추가" /></StackPanel>
                            </Button>
                            <Button Command="{Binding RemoveTagCommand}" CommandParameter="{Binding TagInput}"
                                    MinHeight="38" Padding="10,6" AutomationProperties.Name="입력한 태그를 선택 메모에서 제거">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconStyle}" /><TextBlock Text="태그 제거" /></StackPanel>
                            </Button>
                            </StackPanel>
                            </Expander>

                            <Expander x:Name="StartupSettingsDisclosure" IsExpanded="False" Margin="0,12,0,0"
                                      Foreground="{StaticResource MutedBrush}"
                                      AutomationProperties.Name="Windows 로그인 설정 펼치기">
                            <Expander.Header>
                                <TextBlock Text="Windows 로그인 설정" TextElement.Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="Windows 로그인 설정" />
                            </Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                            <CheckBox Content="로그인 시 자동 시작"
                                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                      IsEnabled="{Binding CanConfigureStartup}"
                                      Foreground="{StaticResource TextBrush}"
                                      AutomationProperties.Name="Windows 로그인 시 Notedex 자동 시작"
                                      ToolTip="현재 사용자 계정으로 로그인할 때 이 앱을 실행합니다. 기본값은 꺼짐입니다." />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StartupStateMessage}"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Margin="0,0,8,0" ToolTip="{Binding StartupStateMessage}"
                                           AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.Name="Windows 자동 시작 등록 상태" />
                                <Button Grid.Column="1" Command="{Binding RefreshStartupCommand}"
                                        IsEnabled="{Binding CanConfigureStartup}"
                                        Padding="8,5" MinHeight="34"
                                        AutomationProperties.Name="Windows 자동 시작 등록 상태 새로고침"
                                        ToolTip="Windows 등록과 현재 실행 경로를 다시 확인합니다.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconStyle}" />
                                        <TextBlock Text="새로고침" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 가운데: 보기·검색과 선택 가능한 메모 목록 -->
            <Border x:Name="ListPane" Grid.Column="1" Style="{StaticResource PaneBorderStyle}"
                    CornerRadius="0" Margin="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="☰ 폴더" Padding="9,5" MinHeight="34" Click="OnOpenNavigationClick"
                                    AutomationProperties.Name="폴더와 메모 보기 탐색 열기" ToolTip="폴더·태그 탐색" />
                        </Grid>
                        <Grid MinHeight="44">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                     Style="{StaticResource SurfaceTextBoxStyle}" MinHeight="44"
                                     AutomationProperties.Name="제목과 본문에서 메모 검색"
                                     ToolTip="제목 또는 본문 검색 · Ctrl+F" />
                            <TextBlock x:Name="SearchPlaceholder" Text="제목 또는 본문 검색" Margin="12,0,12,0"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="정렬" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="150" Style="{StaticResource DarkComboBoxStyle}"
                                      SelectedValue="{Binding SortMode, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag" MinHeight="34"
                                      AutomationProperties.Name="메모 정렬 방식">
                                <ComboBoxItem Content="최근 수정" Tag="modified" />
                                <ComboBoxItem Content="제목" Tag="title" />
                                <ComboBoxItem Content="중요도" Tag="priority" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <Grid>
                        <ListBox x:Name="MemoList" ItemsSource="{Binding VisibleMemos}"
                                 SelectedItem="{Binding SelectedMemo, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource MemoListItemTemplate}"
                                 ItemContainerStyle="{StaticResource MemoListItemContainerStyle}"
                                 SelectionChanged="OnMemoListSelectionChanged"
                                 PreviewMouseLeftButtonUp="OnMemoListPreviewMouseLeftButtonUp" KeyDown="OnMemoListKeyDown"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="검색 결과와 메모 목록" />
                            <Border Background="{StaticResource PanelBrush}" Padding="20" CornerRadius="10"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VisibleMemos.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="표시할 메모가 없습니다" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock Text="검색어를 지우거나 다른 보기를 선택해 보세요." Foreground="{StaticResource MutedBrush}"
                                           TextAlignment="Center" Margin="0,8,0,0" />
                                <Button Command="{Binding NewMemoCommand}" Click="OnNewMemoClick" Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Center" Margin="0,16,0,0" AutomationProperties.Name="검색 결과가 없을 때 새 메모 만들기">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource IconStyle}" /><TextBlock Text="새 메모" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 오른쪽: 제목/본문 편집, Markdown preview, 상태와 명령 -->
            <Border x:Name="EditorPane" Grid.Column="2" Style="{StaticResource PaneBorderStyle}"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                    CornerRadius="0" Margin="0" Padding="8,0,4,0">
                <Grid>
                    <!--
                    name         : EditorPaneLayout
                    desc         : Compact windows keep the save footer in its fixed row while the body editor uses the remaining star-sized space and its own scroll bar.
                    author       : NotedexOrig3
                    create date  : 2026-10-24
                    update date  : 2026-10-24 NotedexOrig3 : Remove the oversized editor minimum that caused body/footer overlap at compact heights.
                    -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="BackToListButton" Content="‹ 목록" Padding="8,3" MinHeight="34" Click="OnCompactListClick"
                                AutomationProperties.Name="메모 목록으로 돌아가기" />
                        <Button Grid.Column="2" Content="⋯" FontSize="18" MinHeight="34" Padding="8,2"
                                AutomationProperties.Name="선택 메모 명령" ToolTip="선택 메모의 고정·표시·삭제 명령" >
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="고정 또는 고정 해제" Command="{Binding TogglePinnedCommand}" />
                                    <MenuItem Header="중요도">
                                        <MenuItem Header="일반" Command="{Binding SetPriorityCommand}" CommandParameter="0" />
                                        <MenuItem Header="중요" Command="{Binding SetPriorityCommand}" CommandParameter="1" />
                                        <MenuItem Header="긴급" Command="{Binding SetPriorityCommand}" CommandParameter="2" />
                                    </MenuItem>
                                    <MenuItem Header="메모 색상">
                                        <MenuItem Header="기본" Command="{Binding SetNoteColorCommand}" CommandParameter="default" />
                                        <MenuItem Header="보라" Command="{Binding SetNoteColorCommand}" CommandParameter="purple" />
                                        <MenuItem Header="파랑" Command="{Binding SetNoteColorCommand}" CommandParameter="blue" />
                                        <MenuItem Header="초록" Command="{Binding SetNoteColorCommand}" CommandParameter="green" />
                                        <MenuItem Header="장미" Command="{Binding SetNoteColorCommand}" CommandParameter="rose" />
                                    </MenuItem>
                                    <MenuItem Header="본문 글자 크기">
                                        <MenuItem Header="12" Command="{Binding SetNoteFontSizeCommand}" CommandParameter="12" />
                                        <MenuItem Header="14" Command="{Binding SetNoteFontSizeCommand}" CommandParameter="14" />
                                        <MenuItem Header="16" Command="{Binding SetNoteFontSizeCommand}" CommandParameter="16" />
                                        <MenuItem Header="18" Command="{Binding SetNoteFontSizeCommand}" CommandParameter="18" />
                                        <MenuItem Header="20" Command="{Binding SetNoteFontSizeCommand}" CommandParameter="20" />
                                        <MenuItem Header="24" Command="{Binding SetNoteFontSizeCommand}" CommandParameter="24" />
                                        <MenuItem Header="28" Command="{Binding SetNoteFontSizeCommand}" CommandParameter="28" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="메모 배치 잠금/해제" Command="{Binding TogglePlacementLockCommand}" />
                                    <MenuItem Header="이 메모 위치 초기화" Command="{Binding ResetPlacementCommand}" />
                                    <Separator />
                                    <MenuItem Header="바탕화면에 표시" Command="{Binding ShowMemoCommand}" />
                                    <MenuItem Header="바탕화면에서 숨기기" Command="{Binding HideMemoCommand}" />
                                    <Separator />
                                    <MenuItem Header="휴지통으로 이동" Command="{Binding MoveToTrashCommand}" />
                                    <MenuItem Header="메모 복구" Command="{Binding RestoreMemoCommand}" />
                                    <MenuItem Header="영구 삭제" Command="{Binding PermanentlyDeleteCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,0,0,6">
                        <TextBox Text="{Binding SelectedMemo.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="26" FontWeight="SemiBold" MaxLength="200" Background="Transparent"
                                 AutomationProperties.Name="선택 메모 제목 편집">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource SurfaceTextBoxStyle}">
                                    <Setter Property="IsReadOnly" Value="True" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Padding" Value="2,4" />
                                    <Setter Property="FontSize" Value="26" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMemo.IsEditable}" Value="True"><Setter Property="IsReadOnly" Value="False" /></DataTrigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" /></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,6">
                        <WrapPanel x:Name="MemoActionsPanel" VerticalAlignment="Center" Visibility="Collapsed">
                        <Button x:Name="PriorityButton" Content="{Binding SelectedMemo.PriorityLabel}" MinWidth="100" MinHeight="38"
                                Click="OnOpenPriorityMenu"
                                AutomationProperties.Name="메모 중요도 선택"
                                ToolTip="중요도는 메모 의미 우선순위이며 고정이나 항상 위와 다릅니다">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="일반" Command="{Binding PlacementTarget.DataContext.SetPriorityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="0" />
                                    <MenuItem Header="중요" Command="{Binding PlacementTarget.DataContext.SetPriorityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="1" />
                                    <MenuItem Header="긴급" Command="{Binding PlacementTarget.DataContext.SetPriorityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="2" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Command="{Binding TogglePinnedCommand}" AutomationProperties.Name="선택 메모 고정 또는 고정 해제"
                                ToolTip="고정은 목록에서 빠르게 찾기 위한 설정이며 메모를 항상 위로 올리지 않습니다">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                    <Setter Property="Margin" Value="8,0,0,0" />
                                    <Setter Property="MinHeight" Value="38" />
                                    <Style.Triggers><DataTrigger Binding="{Binding SelectedMemo.IsPinned}" Value="True"><Setter Property="Background" Value="{StaticResource AccentBrush}" /><Setter Property="Foreground" Value="{StaticResource BackgroundBrush}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE840;" Style="{StaticResource IconStyle}" /><TextBlock Text="고정" /></StackPanel>
                        </Button>
                        <Button Command="{Binding ShowMemoCommand}" Style="{StaticResource ShowMemoButtonStyle}" Margin="8,0,0,0" MinHeight="38"
                                AutomationProperties.Name="선택 메모를 바탕화면에 표시">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource IconStyle}" /><TextBlock Text="바탕화면에 표시" /></StackPanel>
                        </Button>
                        <Button Command="{Binding HideMemoCommand}" Style="{StaticResource HideMemoButtonStyle}" Margin="8,0,0,0" MinHeight="38"
                                AutomationProperties.Name="선택 메모 숨기기">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE921;" Style="{StaticResource IconStyle}" /><TextBlock Text="숨기기" /></StackPanel>
                        </Button>
                        <Button Command="{Binding MoveToTrashCommand}" Style="{StaticResource ActiveOnlyButtonStyle}" Margin="8,0,0,0" MinHeight="38"
                                AutomationProperties.Name="선택 메모를 휴지통으로 이동">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconStyle}" /><TextBlock Text="휴지통" /></StackPanel>
                        </Button>
                        <Button Command="{Binding RestoreMemoCommand}" Style="{StaticResource TrashOnlyButtonStyle}" Margin="8,0,0,0" MinHeight="38"
                                AutomationProperties.Name="선택 메모 복구">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource IconStyle}" /><TextBlock Text="복구" /></StackPanel>
                        </Button>
                        <Button Command="{Binding PermanentlyDeleteCommand}" Style="{StaticResource TrashOnlyButtonStyle}" Margin="8,0,0,0" MinHeight="38"
                                AutomationProperties.Name="선택 메모 영구 삭제">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconStyle}" /><TextBlock Text="영구 삭제" /></StackPanel>
                        </Button>
                        </WrapPanel>
                        <Expander x:Name="MetadataDisclosure" IsExpanded="False" Margin="0,0,0,4"
                                  Foreground="{StaticResource MutedBrush}" AutomationProperties.Name="폴더와 태그 편집 펼치기">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="폴더 · 태그" />
                                    <TextBlock Text="  ·  " />
                                    <TextBlock Text="{Binding SelectedMemo.TagsText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="300"
                                               ToolTip="{Binding SelectedMemo.TagsText}" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,6,0,2">
                        <Grid x:Name="FolderTagSelectionRow" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="폴더" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBoxStyle}"
                                      ItemsSource="{Binding Folders}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedMemo.FolderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      MinWidth="88" MinHeight="34" Margin="0,0,12,0" AutomationProperties.Name="선택 메모 폴더 지정" />
                            <TextBlock Grid.Column="2" Text="태그" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="CurrentTagsText" Grid.Column="3" Text="{Binding SelectedMemo.TagsText}" Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       MaxWidth="240" MaxHeight="24" ToolTip="{Binding SelectedMemo.TagsText}"
                                       AutomationProperties.Name="선택 메모 태그" />
                        </Grid>
                        <WrapPanel x:Name="TagEditingRow" Margin="0,6,0,0" VerticalAlignment="Center">
                            <TextBox Text="{Binding TagInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SurfaceTextBoxStyle}" Width="150" MinWidth="88" MinHeight="34"
                                     AutomationProperties.Name="추가하거나 제거할 태그 이름" ToolTip="선택 메모에 추가 또는 제거할 태그" />
                            <Button Content="태그 추가" Command="{Binding AddTagCommand}" MinHeight="34" Padding="10,5" Margin="6,0,0,0"
                                    AutomationProperties.Name="입력한 태그를 선택 메모에 추가" />
                            <Button Content="태그 제거" Command="{Binding RemoveTagCommand}" CommandParameter="{Binding TagInput}"
                                    MinHeight="34" Padding="10,5" Margin="6,0,0,0"
                                    AutomationProperties.Name="입력한 태그를 선택 메모에서 제거" />
                        </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <views:NoteDocumentEditor x:Name="DocumentEditor"
                                                  Session="{Binding DataContext.SelectedMemo.Document, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                  MemoBackground="{Binding DataContext.SelectedMemo.MemoBackground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                  MemoFontSize="{Binding DataContext.SelectedMemo.MemoFontSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                  IsEditable="{Binding DataContext.SelectedMemo.IsEditable, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                  AllowMarkdownMode="True" />
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedMemo.Document.StatusMessage}" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="저장" Click="OnSaveDocumentClick"
                                Padding="10,5" MinHeight="36" Margin="8,0,0,0" AutomationProperties.Name="현재 Markdown 문서 저장" />
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2" CornerRadius="12" Padding="28" Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="메모를 선택하세요" FontSize="21" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock Text="가운데 목록에서 메모를 고르면 원문 편집, Markdown 미리보기, 폴더와 태그를 사용할 수 있습니다."
                               Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,10,0,0" />
                    <Button Command="{Binding NewMemoCommand}" Click="OnNewMemoClick" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" Margin="0,18,0,0" AutomationProperties.Name="새 메모 만들기">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource IconStyle}" /><TextBlock Text="새 메모" /></StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource DeepBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="고정은 목록 접근 · 중요도는 업무 우선순위 · 항상 위는 별도 창 동작"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="20" />
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{StaticResource TextBrush}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="210" MaxHeight="20"
                           ToolTip="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>
    </Grid>
</Window>
