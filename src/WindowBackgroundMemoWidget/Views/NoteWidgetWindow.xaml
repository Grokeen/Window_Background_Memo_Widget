<Window x:Class="WindowBackgroundMemoWidget.Views.NoteWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WindowBackgroundMemoWidget.Views"
        Title="메모 위젯" Width="380" Height="340" MinWidth="240" MinHeight="200"
        WindowStartupLocation="Manual" ShowInTaskbar="False" ShowActivated="False"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip"
        AutomationProperties.Name="바탕화면 메모 위젯">
    <Grid Background="{Binding MemoBackground}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border x:Name="DragHandle" Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="8,6"
                    Cursor="SizeAll" MouseLeftButtonDown="OnDragHandleMouseDown">
                <DockPanel>
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" AutomationProperties.Name="메모 제목" />
                </DockPanel>
            </Border>
            <Button Grid.Column="1" Content="숨기기" Margin="8,0,0,0" Padding="8,4"
                    Click="OnHideClick" AutomationProperties.Name="이 메모 위젯 숨기기"
                    ToolTip="위젯만 숨기며 문서 파일은 보존합니다." />
        </Grid>
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="2"
                          Focusable="False" AutomationProperties.Name="메모 미리보기">
                <StackPanel x:Name="PreviewBlocks" />
            </ScrollViewer>
            <ContentControl x:Name="DocumentEditorHost" Visibility="Collapsed" />
            <Button x:Name="ContinueReadingButton" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="8" Padding="10,5" Content="계속 읽기" Click="OnContinueReadingClick"
                    AutomationProperties.Name="전체 메모 계속 읽기" />
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding WidgetStatus}" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="4,6,4,0" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
