<Window x:Class="WindowBackgroundMemoWidget.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="바탕화면 메모 · M1 기술 검증" Width="780" Height="800" MinWidth="640" MinHeight="600"
        Style="{StaticResource AppWindowStyle}" WindowStartupLocation="CenterScreen" Closing="OnClosing" SourceInitialized="OnSourceInitialized">
    <!--
    name         : MainWindow layout
    desc         : 표시 방식, 메모 조작, 처리 상태와 검증 안내를 구역별로 나누는 제어 화면.
    author       : NotedexOrig2
    create date  : 2026-10-23
    update date  : 2026-10-24 NotedexOrig3 : 공통 테마·기능 아이콘·툴팁·일관된 간격 적용.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="28">
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="DESKTOP MEMO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <Border Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="8,4" HorizontalAlignment="Right">
                    <TextBlock Text="M1 · 자동 저장 없음" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </Border>
            </DockPanel>
            <TextBlock Text="바탕화면에 남기는 작은 메모" FontSize="27" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock Text="표시 방식을 비교하고, 이 PC에서 입력과 창 동작을 확인합니다." Foreground="{StaticResource MutedBrush}" />

            <!-- 설명을 선택 영역 안에 넣어 모드 이름과 설명 모두 클릭할 수 있게 한다. -->
            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,24,0,24">
                <StackPanel>
                    <TextBlock Text="01  표시 방식" Style="{StaticResource SectionTitleStyle}" />
                    <RadioButton x:Name="BottomMode" IsChecked="True" GroupName="Mode" Checked="OnModeChanged"
                                 AutomationProperties.Name="일반 창 · 맨 아래 배치" ToolTip="일반 프로그램 아래에 배치합니다. Win + D 동작을 확인하세요.">
                        <StackPanel>
                            <TextBlock Text="일반 창 · 맨 아래 배치" FontWeight="SemiBold" />
                            <TextBlock Text="일반 프로그램 아래에 배치합니다. Win + D를 누르면 함께 숨겨질 수 있습니다."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ShellMode" GroupName="Mode" Checked="OnModeChanged" Margin="0,8,0,0"
                                 AutomationProperties.Name="Explorer 셸 결합 · 실험" ToolTip="바탕화면 아이콘 영역에 결합하는 실험 모드입니다.">
                        <StackPanel>
                            <TextBlock Text="Explorer 셸 결합 · 실험" FontWeight="SemiBold" />
                            <TextBlock Text="바탕화면 아이콘 영역에 결합합니다. Windows 버전·배율·한글 IME 동작 확인이 필요합니다."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <TextBlock Text="02  메모와 진단" Style="{StaticResource SectionTitleStyle}" />
            <WrapPanel>
                <Button x:Name="OpenMemoButton" Click="OnOpenMemo" Style="{StaticResource PrimaryButtonStyle}"
                        AutomationProperties.Name="메모 열기" ToolTip="선택한 표시 방식으로 임시 메모를 열거나 다시 표시합니다.">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconStyle}" Text="&#xE710;" /><TextBlock Text="메모 열기" /></StackPanel>
                </Button>
                <Button Click="OnHideMemo" AutomationProperties.Name="메모 숨기기" ToolTip="메모를 숨깁니다. 임시 본문은 앱을 종료할 때까지 유지됩니다.">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconStyle}" Text="&#xE921;" /><TextBlock Text="숨기기" /></StackPanel>
                </Button>
                <Button Click="OnResetPlacement" AutomationProperties.Name="화면 안으로 복구" ToolTip="화면 밖의 메모를 현재 모니터 작업 영역 안으로 옮깁니다.">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconStyle}" Text="&#xE777;" /><TextBlock Text="화면 안으로 복구" /></StackPanel>
                </Button>
                <Button Click="OnExportDiagnostics" AutomationProperties.Name="진단 내보내기" ToolTip="창 동작의 진단 정보를 JSON으로 내보냅니다. 메모 본문은 포함하지 않습니다.">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconStyle}" Text="&#xEDE1;" /><TextBlock Text="진단 내보내기" /></StackPanel>
                </Button>
            </WrapPanel>
            <Border Style="{StaticResource SectionPanelStyle}" Background="{StaticResource DeepBrush}" Margin="0,8,0,24" Padding="16">
                <StackPanel>
                    <TextBlock Text="현재 상태" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ModeLabel}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Status}" MinHeight="36" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>

            <TextBlock Text="03  직접 확인할 항목" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="① Win + D 이후 메모 표시와 바탕화면 아이콘 조작&#10;② 한글 조합·줄바꿈·복사·붙여넣기와 다른 앱의 포커스&#10;③ 100%·125%·150% 배율, 모니터 분리, 절전과 Explorer 재시작"
                       LineHeight="25" FontSize="13" Foreground="{StaticResource MutedBrush}" />
            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,20,0,0" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" Style="{StaticResource IconStyle}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,3,10,0" />
                    <TextBlock Grid.Column="1" Text="검증용 임시 메모입니다. 입력 내용은 자동 저장되지 않으며 종료하면 사라집니다. 진단 파일에도 메모 본문을 넣지 않습니다."
                               FontSize="12" Foreground="{StaticResource MutedBrush}" LineHeight="20" />
                </Grid>
            </Border>
            <TextBlock Text="0.1.0 기술 검증 빌드 · 개발 NotedexOrig2 / 디자인 NotedexOrig3" FontSize="11" Margin="0,16,0,0" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
    </ScrollViewer>
</Window>
